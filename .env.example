# Copy to .env at the repo root.
DATABASE_URL="postgresql://opsflow:opsflow@localhost:5433/opsflow?schema=public"

# 32+ chars. Generate: openssl rand -hex 32
JWT_SECRET="change-me-in-production-0000000000000000000000000000"
JWT_EXPIRES_IN="12h"

PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Accounts permitted to hold super-admin rights — the only people who can create,
# disable, re-role or reset a user account. Comma-separated. Add the third address
# here when it is decided; no code change and no deploy is needed.
# Being on this list is necessary but not sufficient: an existing super admin must
# also grant the flag.
SUPER_ADMIN_EMAILS="ahmed@soccertex.biz,laila@soccertex.biz"

# Per-account sign-in throttle (the per-IP limit is separate and always on).
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# How many reverse proxies sit in front of the API: "false" for none (direct),
# a hop count such as 1 for a single nginx, or a comma-separated address list.
# This is NOT cosmetic: the login rate limiter keys on the caller's address, and
# behind an unconfigured proxy every request looks like it comes from the proxy —
# so ten bad passwords from one attacker would lock the whole company out of
# sign-in. Set it to match your deployment.
TRUST_PROXY=false

# Storage driver: "local" | "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./.storage"

# Only read when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ═══════════════════════════════════════════════════════════════════════════
# Microsoft 365 / Outlook email
#
# OpsFlow sends a real email whenever somebody makes a meaningful change, using
# the Microsoft Graph API with a Microsoft Entra ID app registration.
#
# ALL FOUR ARE OPTIONAL. Without them OpsFlow works completely: changes are
# tracked, the What Changed page fills, and in-app notifications appear. Only
# the emails are held in a queue — and they go out, in order, the moment these
# are filled in. A factory should not be unable to record production because a
# client secret expired.
#
# Setting these up (about five minutes, needs a Microsoft 365 administrator):
#
#   1. https://entra.microsoft.com → Applications → App registrations → New
#      registration. Name it "OpsFlow Notifications". Single tenant. No
#      redirect URI — this is a background service, not a sign-in flow.
#   2. The Overview page shows "Directory (tenant) ID" and "Application
#      (client) ID". They go in the first two settings below.
#   3. Certificates & secrets → New client secret. Copy the **Value** (not the
#      Secret ID) immediately — it is shown once. That is the third setting.
#      Note its expiry date; email stops when it lapses.
#   4. API permissions → Add a permission → Microsoft Graph → **Application
#      permissions** (NOT delegated) → Mail.Send. That one permission is all
#      OpsFlow needs; do not grant more.
#   5. Press "Grant admin consent for <your tenant>". Application permissions
#      do not work without it, and only an administrator can press it.
#   6. MICROSOFT_SENDER_EMAIL must be a real, licensed mailbox in the tenant —
#      a shared mailbox is ideal. Every message is sent *from* it.
#
# Mail.Send as an application permission lets this app send as ANY mailbox in
# the tenant. To restrict it to only the one below, ask your administrator for
# an ApplicationAccessPolicy in Exchange Online. Recommended, not required.
#
# NEVER commit real values. .env is git-ignored; only .env.example is tracked.
# ═══════════════════════════════════════════════════════════════════════════
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_SENDER_EMAIL=

# Keep a copy of each message in the sender mailbox's Sent Items.
MICROSOFT_SAVE_TO_SENT_ITEMS=true

# Where the web app is reachable, for the "Open in OpsFlow" button in emails.
# Leave blank and the emails simply omit the link — better than a link to
# localhost sitting in somebody's inbox.
# APP_BASE_URL="https://opsflow.yourcompany.com"

# How often the queue retries messages that failed or are waiting on config.
EMAIL_RETRY_INTERVAL_SECONDS=60

# Whether the person who made a change is also told about it. Off by default:
# telling somebody what they just did is the fastest way to teach a factory
# that OpsFlow mail is noise, and then the message that matters gets missed.
NOTIFY_ACTOR=false

# Frontend
VITE_API_URL="http://localhost:4000/api"
