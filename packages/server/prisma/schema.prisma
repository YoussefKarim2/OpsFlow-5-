  date         DateTime
  operation    ProductionOperation
  qty          Int
  line         String?
  team         String?
  notes        String?
  recordedById String?
  createdAt    DateTime            @default(now())
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy   User?               @relation(fields: [recordedById], references: [id])

  @@index([orderId, date])
  @@index([orderId, operation])
  @@map("production_records")
}

model QualityAudit {
  id                     String          @id @default(cuid())
  orderId                String
  inspectionDate         DateTime
  factoryId              String?
  auditType              AuditType       @default(FINAL_AUDIT)
  availableQty           Int
  /// Defaults to the AQL band for availableQty; overridable by the auditor.
  sampleSize             Int?
  acceptedQty            Int?
  rejectedQty            Int?
  /// Verdict. Computed from the AQL table in @opsflow/shared; a manual override
  /// is recorded in `overridden` so it is visible rather than silent.
  result                 AuditResult     @default(PENDING)
  overridden             Boolean         @default(false)
  remarks                String?
  correctiveAction       String?
  /// Cleared when the corrective action task closes. Gates QUALITY_BLOCKED.
  correctiveActionClosed Boolean         @default(false)
  reinspectionOf         String?
  reinspectFor           String?
  auditorId              String?
  factoryRepName         String?
  colorsInspected        String[]
  sizesInspected         String[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  attachments            Attachment[]
  auditor                User?           @relation(fields: [auditorId], references: [id])
  factory                Factory?        @relation(fields: [factoryId], references: [id])
  order                  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  defects                QualityDefect[]

  @@index([orderId, result])
  @@map("quality_audits")
}

model QualityDefect {
  id             String         @id @default(cuid())
  auditId        String
  category       DefectCategory
  qty            Int
  comment        String?
  /// True when found in the re-inspection pass rather than the first.
  isReinspection Boolean        @default(false)
  audit          QualityAudit   @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@map("quality_defects")
}

model PackingList {
