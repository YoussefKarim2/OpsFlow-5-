model CostingRecord {
  id                     String     @id @default(cuid())
  orderId                String     @unique
  costingDate            DateTime?
  /// EGP per USD. Accessory prices on the sheet are quoted in EGP and divided
  /// by this (=0.4/$D$12), so it must be stored with the costing, not inferred.
  dollarRate             Decimal    @default(48.5) @db.Decimal(10, 4)
  dailyCostEgp           Decimal?   @db.Decimal(14, 4)
  machineCount           Int?
  machineDaysUsed        Int?
  daysInLine             Int?
  productionLineMachines Json?
  sublimationCostUsd     Decimal?   @db.Decimal(14, 4)
  embroideryCostUsd      Decimal?   @db.Decimal(14, 4)
  externalOpCostUsd      Decimal?   @db.Decimal(14, 4)
  notes                  String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  lines                  CostLine[]
  order                  Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("costing_records")
}

model CostLine {
  id           String        @id @default(cuid())
  costingId    String
  group        CostGroup
  label        String
  quantity     Decimal?      @db.Decimal(14, 4)
  unit         String
  unitPriceUsd Decimal?      @db.Decimal(14, 6)
  /// Original EGP price where the sheet quoted one, kept for traceability.
  unitPriceEgp Decimal?      @db.Decimal(14, 4)
