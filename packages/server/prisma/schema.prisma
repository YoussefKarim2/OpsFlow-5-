model ProformaInvoice {
  id                  String                @id @default(cuid())
  orderId             String
  /// C4 on the sheet. Free text: the factory's own numbering, not ours.
  number              String?
  /// H5. Defaults to the day it is created, but editable — a proforma is often
  /// dated the day it was agreed, not the day somebody typed it in.
  date                DateTime              @default(now())
  /// The consignee block, B5:D13. Snapshotted onto the invoice rather than read
  /// live from the client, for the same reason as Order.shippingAddress: a
  /// document that has been sent must keep the details it was sent with.
  consignee           String?
  billingAddress      String?
  email               String?
  vesselVoyage        String?
  containerSeal       String?
  shippingDate        DateTime?
  shipmentFrom        String?               @default("Cairo / Egypt")
  shipmentTo          String?
  consolidatingVendor String?
  /// Currency of unitPrice on every line. USD throughout the workbook, but a
  /// column beats an assumption baked into five screens.
  currency            String                @default("USD")
  /// B37:D47 on the sheet — origin, payment terms, bank details. Boilerplate,
  /// but boilerplate that changes; stored per invoice so an old one still
  /// reads as it was sent.
  terms               String?
  /// Null until somebody sends it. A sent proforma is the customer's copy and
  /// the API refuses to edit its lines afterwards.
  sentAt              DateTime?
  preparedById        String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lines               ProformaInvoiceLine[]
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  preparedBy          User?                 @relation("ProformaPreparedBy", fields: [preparedById], references: [id])

  @@index([orderId])
  @@map("proforma_invoices")
}

model ProformaInvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  /// B14 "Item / Description". One line per item as the factory writes it —
  /// usually the style, sometimes split by colour.
  description String
  quantity    Decimal?        @db.Decimal(14, 4)
  unit        String          @default("PCS")
  unitPrice   Decimal?        @db.Decimal(14, 6)
  position    Int             @default(0)
  invoice     ProformaInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("proforma_invoice_lines")
}

model Attachment {
  id                  String             @id @default(cuid())
  orderId             String?
  orderStageId        String?
  stageKey            StageKey?
  taskId              String?
  approvalId          String?
  externalOperationId String?
  qualityAuditId      String?
  shipmentId          String?
  customInstructionId String?
  fileName            String
  documentType        DocumentType       @default(OTHER)
  mimeType            String
  sizeBytes           Int
  /// Driver-agnostic key, never a filesystem path — so the local driver can be
  /// swapped for S3 without touching a single row.
  storageKey          String
  storageDriver       String             @default("local")
  /// Bumped when a file of the same name and type is re-uploaded.
  version             Int                @default(1)
  checksum            String?
  uploadedById        String
  createdAt           DateTime           @default(now())
  approval            Approval?          @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  customInstruction   CustomInstruction? @relation(fields: [customInstructionId], references: [id], onDelete: Cascade)
  externalOperation   ExternalOperation? @relation(fields: [externalOperationId], references: [id], onDelete: Cascade)
  order               Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderStage          OrderStage?        @relation(fields: [orderStageId], references: [id], onDelete: Cascade)
  qualityAudit        QualityAudit?      @relation(fields: [qualityAuditId], references: [id], onDelete: Cascade)
  shipment            Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  task                Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy          User               @relation(fields: [uploadedById], references: [id])

  @@index([orderId])
  @@index([orderId, documentType])
  @@map("attachments")
}

model ActivityLog {
  id         String   @id @default(cuid())
  orderId    String?
  actorId    String?
  /// Snapshotted so history survives a user being deactivated or renamed.
  actorName  String
  action     String
  summary    String
  entityType String?
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

/// Field-level change log. Written by Prisma middleware rather than by each
/// route, so a future endpoint cannot forget to log.
model AuditTrail {
  id         String   @id @default(cuid())
  orderId    String?
  entityType String
  entityId   String
  /// CREATE | UPDATE | DELETE. Defaults to UPDATE because every row written
  /// before the admin audit viewer existed was a field-level update.
  action     String   @default("UPDATE")
  field      String
  oldValue   String?
  newValue   String?
  actorId    String?
  actorName  String
  /// Required for privileged overrides such as shipment:override.
  reason     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
  @@map("audit_trails")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  orderId   String?
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Excel import job — the five-step pipeline in ARCHITECTURE.md §7.
model ImportJob {
  id                String       @id @default(cuid())
  fileName          String
  storageKey        String
  status            ImportStatus @default(UPLOADED)
  profile           String?
  profileConfidence Decimal?     @db.Decimal(5, 4)
  /// Detected sheets, resolved field mappings, and validation issues. JSON
  /// because the shape is per-profile and the job is transient by nature.
  detectedSheets    Json?
  mappings          Json?
  issues            Json?
  preview           Json?
  createdOrderId    String?
  errorMessage      String?
  uploadedById      String
  createdAt         DateTime     @default(now())
  committedAt       DateTime?
  uploadedBy        User         @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById, status])
  @@map("import_jobs")
}

model SavedColumnMapping {
  id                String    @id @default(cuid())
  /// Null for a mapping that applies to any customer with this header shape.
  clientId          String?
  label             String
  /// Stable hash of the sorted, normalised header row, so the right saved
  /// mapping is offered even when a customer sends several file shapes.
  headerFingerprint String
  /// { "order qty": "QUANTITY", "shade": "COLOR", … }
  mapping           Json
  /// Bumped every time the mapping is reused, so the list can show what earns
  /// its keep and stale entries are obvious.
  useCount          Int       @default(0)
  lastUsedAt        DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy         User?     @relation(fields: [createdById], references: [id])

  @@unique([clientId, headerFingerprint])
  @@index([headerFingerprint])
  @@map("saved_column_mappings")
}

