  orderSizeId   String?
  qty           Int
  grossWeightKg Decimal?    @db.Decimal(10, 3)
  netWeightKg   Decimal?    @db.Decimal(10, 3)
  position      Int         @default(0)
  orderColor    OrderColor? @relation(fields: [orderColorId], references: [id])
  orderSize     OrderSize?  @relation(fields: [orderSizeId], references: [id])
